# Application Port
PORT=3300
NODE_ENV=development
BACKEND_URL=http://localhost:3300
FRONTEND_URL=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=replace_with_your_supabase_jwt_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Configuration (Fallback / Custom Auth)
JWT_SECRET=replace_with_a_long_random_jwt_secret
JWT_EXPIRATION=7d
CORS_ORIGINS=http://localhost:3000

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@example.com

# Paystack Payment Gateway

PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_public_key

# Nestuge Payment Gateway
NESTUGE_API_KEY=replace_with_your_nestuge_key
NESTUGE_CHECKOUT_URL=https://example.com/pay

# Payment Information
PAYMENT_CURRENCY=NGN
EARLY_BIRD_PRICE=100000
NORMAL_PRICE=150000
EARLY_BIRD_DEADLINE=2026-12-03
APPLICATION_START_DATE=2026-11-19
APPLICATION_END_DATE=2027-01-03

